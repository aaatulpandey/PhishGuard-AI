# ── Universal Admin Account ───────────────────────────────────────────────────
# These credentials are seeded automatically on first startup.
# Change them BEFORE running for the first time in production.
ADMIN_EMAIL=admin@phishguard.ai
ADMIN_PASSWORD=Admin@1234
ADMIN_FULL_NAME=PhishGuard Admin

# ── Database ──────────────────────────────────────────────────────────────────

# Production PostgreSQL (used by Docker Compose)
DATABASE_URL=postgresql://phishguard_user:phishguard_pass@localhost:5432/phishguard

# Local development fallback – uses SQLite automatically if not set
# DATABASE_URL=sqlite:///./phishguard.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_BEFORE_DEPLOYING

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array format)
CORS_ORIGINS=["http://localhost", "http://localhost:5173", "http://localhost:80"]
