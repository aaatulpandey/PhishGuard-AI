*.db
*.sqlite3
tests/test_phishguard.db

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docker
docker-compose.override.yml

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
